# Template for .env. Copy this file to .env and fill in real values.
# .env is gitignored; this file is committed.

# --- Oxford Economics API ---
# Generate a token via the Swagger UI at:
#   https://model.oxfordeconomics.com/api/v1/swagger
# Open the AccessToken section -> POST /v1/access-token/generate -> Try it out.
# The "Value" field in the response is shown ONLY ONCE.
OE_API_TOKEN=replace-with-your-bearer-token
OE_API_BASE_URL=https://model.oxfordeconomics.com/api
OE_API_TIMEOUT_SECONDS=60
OE_API_MAX_RETRIES=3

# --- App ---
APP_NAME=oxford-economics-api
APP_ENV=local
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
